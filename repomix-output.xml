123: # -----------------------------------------------------------------------------
124: # Preparación de dimensiones
125: # -----------------------------------------------------------------------------
126: def _preparar_tiendas_por_region(df_tienda: pd.DataFrame) -> dict[str, tuple[list[dict], list[float]]]:
127:     columnas_requeridas = {"id_tienda", "nombre", "canal", "region", "prob_seleccion"}
128:     faltantes = columnas_requeridas - set(df_tienda.columns)
129:     if faltantes:
130:         raise ValueError(f"Faltan columnas en dim_tienda: {sorted(faltantes)}")
131: 
132:     tiendas_por_region: dict[str, tuple[list[dict], list[float]]] = {}
133:     for region, grupo in df_tienda.groupby("region"):
134:         grupo = grupo.copy()
135:         grupo["prob_seleccion"] = pd.to_numeric(grupo["prob_seleccion"], errors="coerce").fillna(0)
136:         grupo = grupo[grupo["prob_seleccion"] > 0]
137:         if grupo.empty:
138:             raise ValueError(f"La región {region!r} no tiene tiendas con prob_seleccion positiva.")
139:         tiendas_por_region[str(region)] = (
140:             grupo.to_dict("records"),
141:             _normalizar_pesos(grupo["prob_seleccion"]),
142:         )
143:     return tiendas_por_region
144: 
145: 
146: def _preparar_productos(df_producto: pd.DataFrame) -> dict[str, Any]:
147:     columnas_requeridas = {
148:         "id_producto",
149:         "nombre",
150:         "categoria",
151:         "subcategoria",
152:         "precio_lista",
153:         "costo_unitario_promedio",
154:         "producto_estrella",
155:     }
156:     faltantes = columnas_requeridas - set(df_producto.columns)
157:     if faltantes:
158:         raise ValueError(f"Faltan columnas en dim_producto: {sorted(faltantes)}")
159: 
160:     df = df_producto.copy()
161:     for col in COLUMNAS_ASOCIACION:
162:         if col not in df.columns:
163:             df[col] = pd.NA
164: 
165:     df["precio_lista"] = pd.to_numeric(df["precio_lista"], errors="coerce")
166:     df["costo_unitario_promedio"] = pd.to_numeric(df["costo_unitario_promedio"], errors="coerce")
167:     df = df.dropna(subset=["id_producto", "subcategoria", "precio_lista", "costo_unitario_promedio"])
168:     if df.empty:
169:         raise ValueError("dim_producto no tiene productos válidos.")
170: 
171:     producto_estrella_normalizado = df["producto_estrella"].astype(str).str.strip().str.lower()
172:     df["producto_estrella"] = producto_estrella_normalizado.isin({"true", "1", "si", "sí", "yes", "y"})
173: 
174:     productos = df.to_dict("records")
175:     productos_estrella = [p for p in productos if bool(p["producto_estrella"])]
176:     productos_no_estrella = [p for p in productos if not bool(p["producto_estrella"])]
177: 
178:     if not productos_estrella:
179:         raise ValueError("No existen productos marcados como producto_estrella=True.")
180:     if not productos_no_estrella:
181:         raise ValueError("No existen productos marcados como producto_estrella=False.")
182: 
183:     productos_por_subcategoria: dict[str, list[dict]] = defaultdict(list)
184:     for producto in productos:
185:         productos_por_subcategoria[_normalizar_texto(producto["subcategoria"])].append(producto)
186: 
187:     return {
188:         "productos_estrella": productos_estrella,
189:         "productos_no_estrella": productos_no_estrella,
190:         "productos_por_subcategoria": dict(productos_por_subcategoria),
191:     }
192: 
193: 
194: def _preparar_promociones(df_promocion: pd.DataFrame) -> pd.DataFrame:
195:     columnas_requeridas = {"id_promocion", "tipo", "descuento_pct", "fecha_inicio", "fecha_fin"}
196:     faltantes = columnas_requeridas - set(df_promocion.columns)
197:     if faltantes:
198:         raise ValueError(f"Faltan columnas en dim_promocion: {sorted(faltantes)}")
199: 
200:     df = df_promocion.copy()
201:     df["fecha_inicio"] = pd.to_datetime(df["fecha_inicio"], dayfirst=True, errors="coerce").dt.date
202:     df["fecha_fin"] = pd.to_datetime(df["fecha_fin"], dayfirst=True, errors="coerce").dt.date
203:     df["descuento_pct"] = pd.to_numeric(df["descuento_pct"], errors="coerce").fillna(0.0)
204:     df = df.dropna(subset=["id_promocion", "tipo", "fecha_inicio", "fecha_fin"])
205: 
206:     if df.empty:
207:         raise ValueError("dim_promocion no tiene promociones válidas.")
208:     return df
209: 
