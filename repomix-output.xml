 84:     "def cargar_tabla(nombre: str) -> pd.DataFrame:\n",
 85:     "    path = DATA_PROCESSED / TABLAS[nombre]\n",
 86:     "    if not path.exists():\n",
 87:     "        raise FileNotFoundError(f\"No se encontró {path}\")\n",
 88:     "    return pd.read_csv(path, sep=SEP, encoding=ENC)\n",
 89:     "\n",
 90:     "\n",
 91:     "def reporte_calidad(df: pd.DataFrame, nombre: str) -> pd.DataFrame:\n",
 92:     "    filas = len(df)\n",
 93:     "    nulos = df.isna().sum()\n",
 94:     "    pct_nulos = (nulos / filas * 100).round(2) if filas else 0\n",
 95:     "    resumen = pd.DataFrame({\n",
 96:     "        \"columna\": df.columns,\n",
 97:     "        \"tipo\": df.dtypes.astype(str).values,\n",
 98:     "        \"nulos\": nulos.values,\n",
 99:     "        \"pct_nulos\": pct_nulos.values if hasattr(pct_nulos, \"values\") else pct_nulos,\n",
100:     "        \"unicos\": [df[c].nunique() for c in df.columns],\n",
101:     "    })\n",
102:     "    print(f\"\\n=== Calidad inicial: {nombre} ({filas:,} filas) ===\")\n",
103:     "    display(resumen)\n",
104:     "    return resumen\n",
105:     "\n",
106:     "\n",
107:     "def contar_duplicados_grano(df: pd.DataFrame, columnas: list[str]) -> int:\n",
108:     "    return int(df.duplicated(subset=columnas).sum())\n",
109:     "\n",
110:     "\n",
111:     "def contar_huérfanas(fact_col, dim_col) -> int:\n",
112:     "    valores_fact = set(fact_col.dropna())\n",
113:     "    valores_dim = set(dim_col.dropna())\n",
114:     "    return len(valores_fact - valores_dim)"
115:    ]
