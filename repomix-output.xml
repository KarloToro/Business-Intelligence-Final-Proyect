246: # -----------------------------------------------------------------------------
247: # Selecciones del ticket
248: # -----------------------------------------------------------------------------
249: def _seleccionar_cliente(
250:     clientes_records: list[dict],
251:     indice_ticket: int,
252:     pesos_recompra: list[float],
253:     rng: random.Random,
254: ) -> tuple[int, dict]:
255:     """Primera etapa: cliente secuencial. Luego: selección ponderada por recompra."""
256:     if indice_ticket < len(clientes_records):
257:         return indice_ticket, clientes_records[indice_ticket]
258: 
259:     indices = list(range(len(clientes_records)))
260:     idx = rng.choices(indices, weights=pesos_recompra, k=1)[0]
261:     return idx, clientes_records[idx]
262: 
263: 
264: def _seleccionar_tienda(
265:     region_cliente: str,
266:     tiendas_por_region: dict[str, tuple[list[dict], list[float]]],
267:     rng: random.Random,
268: ) -> dict:
269:     if region_cliente not in tiendas_por_region:
270:         raise ValueError(f"No hay tiendas disponibles para la región del cliente: {region_cliente!r}")
271:     tiendas, pesos = tiendas_por_region[region_cliente]
272:     return rng.choices(tiendas, weights=pesos, k=1)[0]
273: 
274: 
275: def _seleccionar_producto_base(productos_info: dict[str, Any], rng: random.Random) -> dict:
276:     if rng.random() < PROB_PRODUCTO_ESTRELLA:
277:         return rng.choice(productos_info["productos_estrella"])
278:     return rng.choice(productos_info["productos_no_estrella"])
279: 
280: 
281: def _seleccionar_producto_por_subcategoria(
282:     subcategoria: str,
283:     productos_info: dict[str, Any],
284:     rng: random.Random,
285:     ids_ya_elegidos: set[int],
286: ) -> dict | None:
287:     clave = _normalizar_texto(subcategoria)
288:     candidatos = productos_info["productos_por_subcategoria"].get(clave, [])
289:     if not candidatos:
290:         return None
291: 
292:     candidatos_no_repetidos = [p for p in candidatos if int(p["id_producto"]) not in ids_ya_elegidos]
293:     candidatos_finales = candidatos_no_repetidos or candidatos
294:     elegido = rng.choice(candidatos_finales)
295: 
296:     if int(elegido["id_producto"]) in ids_ya_elegidos:
297:         return None
298:     return elegido
299: 
300: 
301: def _agregar_asociaciones_recursivas(
302:     producto_origen: dict,
303:     productos_ticket: list[dict],
304:     ids_ya_elegidos: set[int],
305:     productos_info: dict[str, Any],
306:     rng: random.Random,
307:     profundidad_actual: int,
308: ) -> None:
309:     if profundidad_actual >= MAX_PROFUNDIDAD_ASOCIACION:
310:         return
311:     if len(productos_ticket) >= MAX_LINEAS_POR_VENTA:
312:         return
313: 
314:     for columna in COLUMNAS_ASOCIACION:
315:         if len(productos_ticket) >= MAX_LINEAS_POR_VENTA:
316:             break
317: 
318:         subcategoria_asociada = _limpiar_asociacion(producto_origen.get(columna))
319:         if not subcategoria_asociada:
320:             continue
321: 
322:         if rng.random() >= PROB_ASOCIACION:
323:             continue
324: 
325:         producto_asociado = _seleccionar_producto_por_subcategoria(
326:             subcategoria=subcategoria_asociada,
327:             productos_info=productos_info,
328:             rng=rng,
329:             ids_ya_elegidos=ids_ya_elegidos,
330:         )
331:         if producto_asociado is None:
332:             continue
333: 
334:         productos_ticket.append(producto_asociado)
335:         ids_ya_elegidos.add(int(producto_asociado["id_producto"]))
336: 
337:         # Recursividad limitada: permite canastas más naturales sin tickets exagerados.
338:         _agregar_asociaciones_recursivas(
339:             producto_origen=producto_asociado,
340:             productos_ticket=productos_ticket,
341:             ids_ya_elegidos=ids_ya_elegidos,
342:             productos_info=productos_info,
343:             rng=rng,
344:             profundidad_actual=profundidad_actual + 1,
345:         )
346: 
347: 
348: def _generar_productos_ticket(productos_info: dict[str, Any], rng: random.Random) -> list[dict]:
349:     producto_base = _seleccionar_producto_base(productos_info, rng)
350:     productos_ticket = [producto_base]
351:     ids_ya_elegidos = {int(producto_base["id_producto"])}
352: 
353:     _agregar_asociaciones_recursivas(
354:         producto_origen=producto_base,
355:         productos_ticket=productos_ticket,
356:         ids_ya_elegidos=ids_ya_elegidos,
357:         productos_info=productos_info,
358:         rng=rng,
359:         profundidad_actual=0,
360:     )
361:     return productos_ticket
362: 
