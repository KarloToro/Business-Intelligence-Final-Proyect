438: # -----------------------------------------------------------------------------
439: # Generador principal
440: # -----------------------------------------------------------------------------
441: def generar_ventas_y_actualizar_clientes(
442:     total_clientes: int = TOTAL_CLIENTES,
443:     seed: int = SEED,
444:     fecha_inicio: str = FECHA_INICIO_OPERACION,
445:     fecha_fin_exclusiva: str = FECHA_FIN_EXCLUSIVA_OPERACION,
446: ) -> tuple[pd.DataFrame, pd.DataFrame]:
447:     """Genera dim_cliente actualizado y fact_ventas con el algoritmo definitivo.
448: 
449:     Reglas implementadas:
450:     1. El calendario produce 45 tickets diarios, excepto julio y diciembre con 60.
451:     2. Los primeros tickets garantizan una primera compra para cada cliente.
452:     3. Las recompras seleccionan clientes ponderando por probabilidad_recompra.
453:     4. La tienda se elige después del cliente y solo dentro de su región.
454:     5. Cada ticket parte de un producto base: 80% estrella y 20% no estrella.
455:     6. Las asociaciones de productos se agregan con probabilidad de 15%, con límite
456:        de profundidad y de líneas por venta.
457:     7. Las promociones solo aplican si están vigentes en la fecha del ticket.
458:     8. fecha_alta se toma de la primera venta real del cliente y no se modifica.
459:     """
460:     rng = random.Random(seed)
461: 
462:     fechas_tickets = construir_calendario_tickets(
463:         fecha_inicio=fecha_inicio,
464:         fecha_fin_exclusiva=fecha_fin_exclusiva,
465:     )
466:     if len(fechas_tickets) < total_clientes:
467:         raise ValueError(
468:             "El calendario genera menos tickets que clientes. No se puede garantizar "
469:             "una primera compra para cada cliente."
470:         )
471: 
472:     clientes = generar_clientes(total_clientes=total_clientes, seed=seed).copy()
473:     clientes = clientes.sort_values("id_cliente").reset_index(drop=True)
474:     clientes_records = clientes.to_dict("records")
475: 
476:     productos_info = _preparar_productos(_leer_csv_semicolon(DATA_DIR / "dim_producto.csv"))
477:     tiendas_por_region = _preparar_tiendas_por_region(_leer_csv_semicolon(DATA_DIR / "dim_tienda.csv"))
478:     promociones = _preparar_promociones(_leer_csv_semicolon(DATA_DIR / "dim_promocion.csv"))
479:     promos_por_fecha = _preparar_promos_por_fecha(promociones, fechas_tickets)
480: 
481:     pesos_recompra = [float(probabilidad_recompra[c["segmento_programa"]]) for c in clientes_records]
482: 
483:     registros_ventas: list[dict] = []
484: 
485:     for indice_ticket, fecha in enumerate(fechas_tickets):
486:         id_venta = indice_ticket + 1
487:         idx_cliente, cliente = _seleccionar_cliente(
488:             clientes_records=clientes_records,
489:             indice_ticket=indice_ticket,
490:             pesos_recompra=pesos_recompra,
491:             rng=rng,
492:         )
493: 
494:         if pd.isna(clientes.at[idx_cliente, "fecha_alta"]):
495:             clientes.at[idx_cliente, "fecha_alta"] = fecha.isoformat()
496:             cliente["fecha_alta"] = fecha.isoformat()
497: 
498:         tienda = _seleccionar_tienda(
499:             region_cliente=str(cliente["region"]),
500:             tiendas_por_region=tiendas_por_region,
501:             rng=rng,
502:         )
503:         productos_ticket = _generar_productos_ticket(productos_info, rng)
504:         promocion_ticket = _elegir_promocion(
505:             fecha_venta=fecha,
506:             segmento_cliente=str(cliente["segmento_programa"]),
507:             tienda=tienda,
508:             promos_por_fecha=promos_por_fecha,
509:             rng=rng,
510:         )
511: 
512:         for numero_linea, producto in enumerate(productos_ticket, start=1):
513:             registros_ventas.append(
514:                 _crear_linea_venta(
515:                     id_venta=id_venta,
516:                     fecha=fecha,
517:                     cliente=cliente,
518:                     tienda=tienda,
519:                     producto=producto,
520:                     promocion=promocion_ticket,
521:                     numero_linea=numero_linea,
522:                     rng=rng,
523:                 )
524:             )
525: 
526:     fact_ventas = pd.DataFrame(registros_ventas)
527:     clientes["fecha_alta"] = pd.to_datetime(clientes["fecha_alta"], errors="coerce").dt.date.astype(str)
528:     return clientes, fact_ventas
529: 
530: 
531: def validar_resultados(clientes: pd.DataFrame, fact_ventas: pd.DataFrame) -> dict[str, Any]:
532:     """Validaciones básicas para confirmar consistencia del dataset generado."""
533:     clientes_tmp = clientes.copy()
534:     ventas_tmp = fact_ventas.copy()
535:     clientes_tmp["fecha_alta"] = pd.to_datetime(clientes_tmp["fecha_alta"], errors="coerce")
536:     ventas_tmp["fecha"] = pd.to_datetime(ventas_tmp["fecha"], errors="coerce")
537: 
538:     primera_venta = ventas_tmp.groupby("id_cliente")["fecha"].min()
539:     clientes_indexados = clientes_tmp.set_index("id_cliente")
540:     comparacion = clientes_indexados["fecha_alta"].eq(primera_venta)
541: 
542:     tickets_por_fecha = ventas_tmp.drop_duplicates("id_venta").groupby(ventas_tmp["fecha"].dt.date)["id_venta"].count()
543:     dias_invalidos = []
544:     for fecha, cantidad in tickets_por_fecha.items():
545:         esperado = VENTAS_DIARIAS_PICO if fecha.month in MESES_PICO else VENTAS_DIARIAS_BASE
546:         if int(cantidad) != esperado:
547:             dias_invalidos.append((fecha.isoformat(), int(cantidad), esperado))
548: 
549:     return {
550:         "clientes": int(len(clientes_tmp)),
551:         "tickets": int(ventas_tmp["id_venta"].nunique()),
552:         "lineas_venta": int(len(ventas_tmp)),
553:         "fecha_min": str(ventas_tmp["fecha"].min().date()),
554:         "fecha_max": str(ventas_tmp["fecha"].max().date()),
555:         "clientes_sin_fecha_alta": int(clientes_tmp["fecha_alta"].isna().sum()),
556:         "clientes_sin_venta": int(len(set(clientes_tmp["id_cliente"]) - set(ventas_tmp["id_cliente"]))),
557:         "fecha_alta_no_coincide_con_primera_venta": int((~comparacion).sum()),
558:         "dias_con_cantidad_tickets_incorrecta": dias_invalidos[:10],
559:         "total_dias_invalidos": int(len(dias_invalidos)),
560:     }
561: 
562: 
563: def guardar_salidas(clientes: pd.DataFrame, fact_ventas: pd.DataFrame) -> tuple[Path, Path]:
564:     OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
565:     ruta_clientes = OUTPUT_DIR / "dim_cliente.csv"
566:     ruta_ventas = OUTPUT_DIR / "fact_ventas.csv"
567:     clientes.to_csv(ruta_clientes, sep=";", index=False, encoding="utf-8")
568:     fact_ventas.to_csv(ruta_ventas, sep=";", index=False, encoding="utf-8")
569:     return ruta_clientes, ruta_ventas
570: 
571: 
572: if __name__ == "__main__":
573:     clientes_generados, ventas_generadas = generar_ventas_y_actualizar_clientes()
574:     ruta_clientes, ruta_ventas = guardar_salidas(clientes_generados, ventas_generadas)
575:     validacion = validar_resultados(clientes_generados, ventas_generadas)
576: 
577:     print("Generación terminada.")
578:     print(f"Clientes: {validacion['clientes']:,}")
579:     print(f"Tickets de venta: {validacion['tickets']:,}")
580:     print(f"Líneas de venta: {validacion['lineas_venta']:,}")
581:     print(f"Rango ventas: {validacion['fecha_min']} a {validacion['fecha_max']}")
582:     print(f"Clientes sin fecha_alta: {validacion['clientes_sin_fecha_alta']:,}")
583:     print(f"Clientes sin venta: {validacion['clientes_sin_venta']:,}")
584:     print(
585:         "fecha_alta distinta a primera venta: "
586:         f"{validacion['fecha_alta_no_coincide_con_primera_venta']:,}"
587:     )
588:     print(f"Días con cantidad de tickets incorrecta: {validacion['total_dias_invalidos']:,}")
589:     print(f"Archivo clientes: {ruta_clientes}")
590:     print(f"Archivo ventas: {ruta_ventas}")
