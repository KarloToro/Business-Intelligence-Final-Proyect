  2: import pandas as pd
  3: 
  4: 
  5: PROJECT_ROOT = Path(__file__).resolve().parents[1]
  6: DATA_DIR = PROJECT_ROOT / "data" / "processed"
  7: 
  8: 
  9: def leer(nombre: str) -> pd.DataFrame:
 10:     return pd.read_csv(DATA_DIR / nombre, sep=";", encoding="utf-8")
 11: 
 12: 
 13: def main():
 14:     clientes = leer("dim_cliente.csv")
 15:     productos = leer("dim_producto.csv")
 16:     ventas = leer("fact_ventas.csv")
 17: 
 18:     df = (
 19:         ventas
 20:         .merge(clientes[["id_cliente", "nombre", "segmento_programa", "region"]], on="id_cliente", how="left")
 21:         .merge(productos[["id_producto", "nombre", "categoria", "subcategoria", "producto_estrella"]], 
 22:                on="id_producto", how="left", suffixes=("", "_producto"))
 23:     )
 24: 
