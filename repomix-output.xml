<file path="scripts/validar_dataset.py">
  1: from __future__ import annotations
  2: 
  3: from pathlib import Path
  4: import pandas as pd
  5: 
  6: 
  7: PROJECT_ROOT = Path(__file__).resolve().parents[1]
  8: DATA_DIR = PROJECT_ROOT / "data" / "processed"
  9: 
 10: ARCHIVOS = {
 11:     "cliente": DATA_DIR / "dim_cliente.csv",
 12:     "producto": DATA_DIR / "dim_producto.csv",
 13:     "promocion": DATA_DIR / "dim_promocion.csv",
 14:     "tiempo": DATA_DIR / "dim_tiempo.csv",
 15:     "tienda": DATA_DIR / "dim_tienda.csv",
 16:     "ventas": DATA_DIR / "fact_ventas.csv",
 17: }
 18: 
 19: 
 20: def leer_csv(nombre: str) -> pd.DataFrame:
 21:     path = ARCHIVOS[nombre]
 22: 
 23:     if not path.exists():
 24:         raise FileNotFoundError(f"No existe el archivo: {path}")
 25: 
 26:     return pd.read_csv(path, sep=";", encoding="utf-8")
 27: 
 28: 
 29: def assert_sin_nulos(df: pd.DataFrame, columnas: list[str], nombre_tabla: str) -> None:
 30:     nulos = df[columnas].isna().sum()
 31:     nulos = nulos[nulos > 0]
 32: 
 33:     if not nulos.empty:
 34:         raise ValueError(f"{nombre_tabla} tiene nulos en columnas críticas:\n{nulos}")
 35: 
 36: 
 37: def assert_pk_unica(df: pd.DataFrame, columna: str, nombre_tabla: str) -> None:
 38:     duplicados = df[columna].duplicated().sum()
 39: 
 40:     if duplicados > 0:
 41:         raise ValueError(f"{nombre_tabla}.{columna} tiene {duplicados} duplicados.")
 42: 
 43: 
 44: def validar_archivos() -> dict[str, pd.DataFrame]:
 45:     print("Validando existencia y lectura de archivos...")
 46: 
 47:     dataframes = {nombre: leer_csv(nombre) for nombre in ARCHIVOS}
 48: 
 49:     for nombre, df in dataframes.items():
 50:         if df.empty:
 51:             raise ValueError(f"{nombre} está vacío.")
 52: 
 53:         print(f"OK {nombre}: {len(df):,} filas")
 54: 
 55:     return dataframes
 56: 
 57: 
 58: def validar_dimensiones(df_cliente, df_producto, df_promocion, df_tiempo, df_tienda) -> None:
 59:     print("\nValidando dimensiones...")
 60: 
 61:     assert_pk_unica(df_cliente, "id_cliente", "dim_cliente")
 62:     assert_pk_unica(df_producto, "id_producto", "dim_producto")
 63:     assert_pk_unica(df_promocion, "id_promocion", "dim_promocion")
 64:     assert_pk_unica(df_tiempo, "fecha", "dim_tiempo")
 65:     assert_pk_unica(df_tienda, "id_tienda", "dim_tienda")
 66: 
 67:     assert_sin_nulos(
 68:         df_cliente,
 69:         ["id_cliente", "nombre", "sexo", "fecha_nacimiento", "distrito", "region", "segmento_programa"],
 70:         "dim_cliente",
 71:     )
 72: 
 73:     assert_sin_nulos(
 74:         df_producto,
 75:         ["id_producto", "nombre", "categoria", "subcategoria", "precio_lista", "costo_unitario_promedio"],
 76:         "dim_producto",
 77:     )
 78: 
 79:     assert_sin_nulos(
 80:         df_promocion,
 81:         ["id_promocion", "tipo", "descuento_pct", "fecha_inicio", "fecha_fin"],
 82:         "dim_promocion",
 83:     )
 84: 
 85:     assert_sin_nulos(
 86:         df_tiempo,
 87:         ["fecha", "dia", "mes", "trimestre", "anio", "dia_semana", "es_feriado"],
 88:         "dim_tiempo",
 89:     )
 90: 
 91:     assert_sin_nulos(
 92:         df_tienda,
 93:         ["id_tienda", "nombre", "canal", "region"],
 94:         "dim_tienda",
 95:     )
 96: 
 97:     if (pd.to_numeric(df_producto["precio_lista"], errors="coerce") <= 0).any():
 98:         raise ValueError("Hay productos con precio_lista <= 0.")
 99: 
100:     if (pd.to_numeric(df_producto["costo_unitario_promedio"], errors="coerce") <= 0).any():
101:         raise ValueError("Hay productos con costo_unitario_promedio <= 0.")
102: 
103:     print("OK dimensiones consistentes.")
104: 
105: 
106: def validar_fact_ventas(df_ventas, df_cliente, df_producto, df_promocion, df_tiempo, df_tienda) -> None:
107:     print("\nValidando fact_ventas...")
108: 
109:     columnas_obligatorias = [
110:         "id_venta",
111:         "numero_linea",
112:         "fecha",
113:         "id_cliente",
114:         "id_tienda",
115:         "id_producto",
116:         "id_promocion",
117:         "cantidad",
118:         "precio_unitario_lista",
119:         "descuento_pct",
120:         "precio_unitario_final",
121:         "importe_venta",
122:         "costo_total",
123:         "margen",
124:     ]
125: 
126:     assert_sin_nulos(df_ventas, columnas_obligatorias, "fact_ventas")
127: 
128:     if df_ventas.duplicated(["id_venta", "numero_linea"]).any():
129:         raise ValueError("Hay líneas duplicadas para la misma combinación id_venta + numero_linea.")
130: 
131:     validar_fk(df_ventas, "id_cliente", df_cliente, "id_cliente", "fact_ventas → dim_cliente")
132:     validar_fk(df_ventas, "id_producto", df_producto, "id_producto", "fact_ventas → dim_producto")
133:     validar_fk(df_ventas, "id_promocion", df_promocion, "id_promocion", "fact_ventas → dim_promocion")
134:     validar_fk(df_ventas, "id_tienda", df_tienda, "id_tienda", "fact_ventas → dim_tienda")
135:     validar_fk(df_ventas, "fecha", df_tiempo, "fecha", "fact_ventas → dim_tiempo")
136: 
137:     for col in ["cantidad", "precio_unitario_lista", "precio_unitario_final", "importe_venta", "costo_total"]:
138:         valores = pd.to_numeric(df_ventas[col], errors="coerce")
139:         if valores.isna().any():
140:             raise ValueError(f"fact_ventas.{col} tiene valores no numéricos.")
141:         if (valores < 0).any():
142:             raise ValueError(f"fact_ventas.{col} tiene valores negativos.")
143: 
144:     if (pd.to_numeric(df_ventas["cantidad"], errors="coerce") <= 0).any():
145:         raise ValueError("fact_ventas.cantidad tiene valores <= 0.")
146: 
147:     print("OK fact_ventas consistente.")
148: 
149: 
150: def validar_fk(df_fact, col_fact, df_dim, col_dim, nombre_relacion: str) -> None:
151:     valores_fact = set(df_fact[col_fact].dropna())
152:     valores_dim = set(df_dim[col_dim].dropna())
153: 
154:     faltantes = valores_fact - valores_dim
155: 
156:     if faltantes:
157:         muestra = list(faltantes)[:10]
158:         raise ValueError(
159:             f"Error FK en {nombre_relacion}. "
160:             f"Hay {len(faltantes)} valores sin correspondencia. Muestra: {muestra}"
161:         )
162: 
163: 
164: def validar_fechas(df_ventas, df_cliente, df_promocion, df_tiempo) -> None:
165:     print("\nValidando fechas...")
166: 
167:     ventas = df_ventas.copy()
168:     clientes = df_cliente.copy()
169:     promociones = df_promocion.copy()
170:     tiempo = df_tiempo.copy()
171: 
172:     ventas["fecha"] = pd.to_datetime(ventas["fecha"], errors="coerce")
173:     clientes["fecha_alta"] = pd.to_datetime(clientes["fecha_alta"], errors="coerce")
174:     promociones["fecha_inicio"] = pd.to_datetime(promociones["fecha_inicio"], errors="coerce", dayfirst=True)
175:     promociones["fecha_fin"] = pd.to_datetime(promociones["fecha_fin"], errors="coerce", dayfirst=True)
176:     tiempo["fecha"] = pd.to_datetime(tiempo["fecha"], errors="coerce")
177: 
178:     if ventas["fecha"].isna().any():
179:         raise ValueError("fact_ventas.fecha tiene fechas inválidas.")
180: 
181:     if tiempo["fecha"].isna().any():
182:         raise ValueError("dim_tiempo.fecha tiene fechas inválidas.")
183: 
184:     primera_venta = ventas.groupby("id_cliente")["fecha"].min()
185:     clientes_idx = clientes.set_index("id_cliente")
186: 
187:     comparacion = clientes_idx["fecha_alta"].eq(primera_venta)
188:     no_coinciden = (~comparacion).sum()
189: 
190:     if no_coinciden > 0:
191:         raise ValueError(f"Hay {no_coinciden} clientes cuya fecha_alta no coincide con su primera venta.")
192: 
193:     ventas_promo = ventas.merge(
194:         promociones[["id_promocion", "tipo", "fecha_inicio", "fecha_fin"]],
195:         on="id_promocion",
196:         how="left",
197:     )
198: 
199:     fuera_vigencia = ventas_promo[
200:         (ventas_promo["fecha"] < ventas_promo["fecha_inicio"])
201:         | (ventas_promo["fecha"] > ventas_promo["fecha_fin"])
202:     ]
203: 
204:     if not fuera_vigencia.empty:
205:         raise ValueError(f"Hay {len(fuera_vigencia):,} líneas con promoción fuera de vigencia.")
206: 
207:     print("OK fechas consistentes.")
208: 
209: 
210: def validar_asociaciones_productos(df_producto) -> None:
211:     print("\nValidando asociaciones de productos...")
212: 
213:     columnas_asociacion = ["asociacion_1", "asociacion_2", "asociacion_3"]
214:     columnas_existentes = [c for c in columnas_asociacion if c in df_producto.columns]
215: 
216:     if not columnas_existentes:
217:         print("AVISO: dim_producto no tiene columnas de asociación. Se omite validación.")
218:         return
219: 
220:     subcategorias_validas = set(
221:         df_producto["subcategoria"]
222:         .astype(str)
223:         .str.strip()
224:         .str.lower()
225:     )
226: 
227:     errores = []
228: 
229:     for _, row in df_producto.iterrows():
230:         id_producto = row["id_producto"]
231: 
232:         for col in columnas_existentes:
233:             valor = row[col]
234: 
235:             if pd.isna(valor) or str(valor).strip() == "":
236:                 continue
237: 
238:             asociacion = str(valor).strip().lower()
239: 
240:             if asociacion in {"nan", "none", "null", "na", "n/a", "sin asociacion", "sin_asociacion"}:
241:                 continue
242: 
243:             if asociacion not in subcategorias_validas:
244:                 errores.append((id_producto, col, valor))
245: 
246:     if errores:
247:         muestra = errores[:20]
248:         raise ValueError(
249:             "Hay asociaciones que no corresponden a ninguna subcategoría existente. "
250:             f"Total errores: {len(errores)}. Muestra: {muestra}"
251:         )
252: 
253:     print("OK asociaciones apuntan a subcategorías válidas.")
254: 
255: 
256: def validar_canastas_generadas(df_ventas, df_producto) -> None:
257:     print("\nValidando canastas generadas...")
258: 
259:     ventas_producto = df_ventas.merge(
260:         df_producto[["id_producto", "subcategoria"]],
261:         on="id_producto",
262:         how="left",
263:     )
264: 
265:     productos_sin_subcategoria = ventas_producto["subcategoria"].isna().sum()
266:     if productos_sin_subcategoria > 0:
267:         raise ValueError(f"Hay {productos_sin_subcategoria} líneas de venta con producto sin subcategoría.")
268: 
269:     lineas_por_ticket = ventas_producto.groupby("id_venta")["numero_linea"].count()
270: 
271:     if (lineas_por_ticket <= 0).any():
272:         raise ValueError("Hay tickets sin líneas.")
273: 
274:     if (lineas_por_ticket > 8).any():
275:         raise ValueError("Hay tickets con más de 8 líneas, rompe MAX_LINEAS_POR_VENTA.")
276: 
277:     duplicados_producto_ticket = ventas_producto.duplicated(["id_venta", "id_producto"]).sum()
278: 
279:     if duplicados_producto_ticket > 0:
280:         raise ValueError(f"Hay {duplicados_producto_ticket} productos repetidos dentro del mismo ticket.")
281: 
282:     print("OK canastas sin duplicados ni exceso de líneas.")
283: 
284: 
285: def imprimir_resumen(df_ventas, df_cliente, df_producto, df_tiempo) -> None:
286:     print("\nResumen del dataset limpio:")
287:     print(f"Clientes: {len(df_cliente):,}")
288:     print(f"Productos: {len(df_producto):,}")
289:     print(f"Días calendario: {len(df_tiempo):,}")
290:     print(f"Tickets de venta: {df_ventas['id_venta'].nunique():,}")
291:     print(f"Líneas de venta: {len(df_ventas):,}")
292:     print(f"Fecha mínima venta: {df_ventas['fecha'].min()}")
293:     print(f"Fecha máxima venta: {df_ventas['fecha'].max()}")
294:     print(f"Clientes con venta: {df_ventas['id_cliente'].nunique():,}")
295:     print(f"Productos vendidos: {df_ventas['id_producto'].nunique():,}")
296: 
297: 
298: def main() -> None:
299:     dfs = validar_archivos()
300: 
301:     df_cliente = dfs["cliente"]
302:     df_producto = dfs["producto"]
303:     df_promocion = dfs["promocion"]
304:     df_tiempo = dfs["tiempo"]
305:     df_tienda = dfs["tienda"]
306:     df_ventas = dfs["ventas"]
307: 
308:     validar_dimensiones(df_cliente, df_producto, df_promocion, df_tiempo, df_tienda)
309:     validar_fact_ventas(df_ventas, df_cliente, df_producto, df_promocion, df_tiempo, df_tienda)
310:     validar_fechas(df_ventas, df_cliente, df_promocion, df_tiempo)
