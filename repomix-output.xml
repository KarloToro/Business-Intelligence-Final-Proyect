211: def _preparar_promos_por_fecha(
212:     promociones: pd.DataFrame,
213:     fechas_tickets: list[datetime.date],
214: ) -> dict[datetime.date, list[dict]]:
215:     fechas_unicas = sorted(set(fechas_tickets))
216:     promos_por_fecha: dict[datetime.date, list[dict]] = {}
217: 
218:     sin_promocion = promociones[promociones["tipo"].astype(str).str.lower().eq("sin_promocion")]
219:     if sin_promocion.empty:
220:         fallback_sin_promo = {"id_promocion": 1, "tipo": "sin_promocion", "descuento_pct": 0.0}
221:     else:
222:         fallback_sin_promo = sin_promocion.iloc[0].to_dict()
223: 
224:     for fecha in fechas_unicas:
225:         candidatas = promociones[
226:             (promociones["fecha_inicio"].le(fecha))
227:             & (promociones["fecha_fin"].ge(fecha))
228:         ].copy()
229:         if candidatas.empty:
230:             candidatas = pd.DataFrame([fallback_sin_promo])
231: 
232:         candidatas["peso_aplicacion"] = candidatas["tipo"].map(
233:             {
234:                 "sin_promocion": 0.82,
235:                 "descuento_directo": 0.12,
236:                 "combo": 0.10,
237:                 "ciber_online": 0.15,
238:                 "fidelizacion": 0.10,
239:             }
240:         ).fillna(0.05)
241: 
242:         promos_por_fecha[fecha] = candidatas.to_dict("records")
243:     return promos_por_fecha
244: 
