364: def _elegir_promocion(
365:     fecha_venta: datetime.date,
366:     segmento_cliente: str,
367:     tienda: dict,
368:     promos_por_fecha: dict[datetime.date, list[dict]],
369:     rng: random.Random,
370: ) -> dict:
371:     candidatas = list(promos_por_fecha.get(fecha_venta, []))
372:     if not candidatas:
373:         candidatas = [{"id_promocion": 1, "tipo": "sin_promocion", "descuento_pct": 0.0, "peso_aplicacion": 1.0}]
374: 
375:     canal = _normalizar_texto(tienda.get("canal", ""))
376:     candidatas_filtradas: list[dict] = []
377:     for promo in candidatas:
378:         tipo = str(promo.get("tipo", "")).strip()
379:         if tipo == "fidelizacion" and segmento_cliente == "No afiliado":
380:             continue
381:         if tipo == "ciber_online" and canal != "online":
382:             continue
383:         candidatas_filtradas.append(promo)
384: 
385:     if not candidatas_filtradas:
386:         candidatas_filtradas = [{"id_promocion": 1, "tipo": "sin_promocion", "descuento_pct": 0.0, "peso_aplicacion": 1.0}]
387: 
388:     pesos = [float(p.get("peso_aplicacion", 0.05)) for p in candidatas_filtradas]
389:     elegida = rng.choices(candidatas_filtradas, weights=pesos, k=1)[0]
390:     return {
391:         "id_promocion": int(elegida["id_promocion"]),
392:         "descuento_pct": float(elegida.get("descuento_pct", 0.0)),
393:     }
394: 
395: 
396: def _cantidad_aleatoria(rng: random.Random) -> int:
397:     return rng.choices([1, 2, 3, 4, 5], weights=[0.58, 0.25, 0.10, 0.05, 0.02], k=1)[0]
398: 
399: 
400: def _crear_linea_venta(
401:     id_venta: int,
402:     fecha: datetime.date,
403:     cliente: dict,
404:     tienda: dict,
405:     producto: dict,
406:     promocion: dict,
407:     numero_linea: int,
408:     rng: random.Random,
409: ) -> dict:
410:     cantidad = _cantidad_aleatoria(rng)
411:     precio_lista = float(producto["precio_lista"])
412:     costo_unitario = float(producto["costo_unitario_promedio"])
413:     descuento_pct = float(promocion["descuento_pct"])
414: 
415:     precio_unitario_final = round(precio_lista * (1 - descuento_pct), 2)
416:     importe_venta = round(precio_unitario_final * cantidad, 2)
417:     costo_total = round(costo_unitario * cantidad, 2)
418:     margen = round(importe_venta - costo_total, 2)
419: 
420:     return {
421:         "id_venta": int(id_venta),
422:         "numero_linea": int(numero_linea),
423:         "fecha": fecha.isoformat(),
424:         "id_cliente": int(cliente["id_cliente"]),
425:         "id_tienda": int(tienda["id_tienda"]),
426:         "id_producto": int(producto["id_producto"]),
427:         "id_promocion": int(promocion["id_promocion"]),
428:         "cantidad": int(cantidad),
429:         "precio_unitario_lista": round(precio_lista, 2),
430:         "descuento_pct": round(descuento_pct, 4),
431:         "precio_unitario_final": precio_unitario_final,
432:         "importe_venta": importe_venta,
433:         "costo_total": costo_total,
434:         "margen": margen,
435:     }
436: 
