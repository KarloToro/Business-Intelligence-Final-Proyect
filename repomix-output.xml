 52: def generar_dim_tiempo() -> pd.DataFrame:
 53:     fechas = pd.date_range(start=FECHA_INICIO, end=FECHA_FIN, freq="D")
 54: 
 55:     df = pd.DataFrame({"fecha": fechas})
 56:     df["id_tiempo"] = df["fecha"].dt.strftime("%Y%m%d").astype(int)
 57:     df["dia"] = df["fecha"].dt.day
 58:     df["mes"] = df["fecha"].dt.month
 59:     df["trimestre"] = df["fecha"].dt.quarter
 60:     df["anio"] = df["fecha"].dt.year
 61:     df["dia_semana"] = df["fecha"].dt.weekday + 1  # lunes=1, domingo=7
 62:     df["es_fin_semana"] = df["dia_semana"].isin([6, 7])
 63:     df["fecha_str"] = df["fecha"].dt.strftime("%Y-%m-%d") # clave auxiliar para cruzar con FERIADOS_PERU
 64:     df["nombre_feriado"] = df["fecha_str"].map(FERIADOS_PERU).fillna("")
 65:     df["es_feriado"] = df["nombre_feriado"].ne("")
 66: 
 67:     df["fecha"] = df["fecha"].dt.strftime("%Y-%m-%d")
 68: 
 69:     columnas = [
 70:         "id_tiempo",
 71:         "fecha",
 72:         "dia",
 73:         "mes",
 74:         "trimestre",
 75:         "anio",
 76:         "dia_semana",
 77:         "es_fin_semana",
 78:         "es_feriado",
 79:         "nombre_feriado",
 80:     ]
 81: 
 82:     return df[columnas]
 83: 
 84: 
 85: def guardar_dim_tiempo(df: pd.DataFrame) -> Path:
 86:     DATA_DIR.mkdir(parents=True, exist_ok=True)
 87:     ruta = DATA_DIR / "dim_tiempo.csv"
 88:     df.to_csv(ruta, sep=";", index=False, encoding="utf-8")
 89:     return ruta
 90: 
 91: 
 92: if __name__ == "__main__":
 93:     dim_tiempo = generar_dim_tiempo()
 94:     ruta_salida = guardar_dim_tiempo(dim_tiempo)
 95: 
 96:     print("Dimensión tiempo generada.")
