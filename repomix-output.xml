 30:     print(f"Líneas de venta: {len(df):,}")
 31:     print(f"Ingresos totales: S/ {df['importe_venta'].sum():,.2f}")
 32:     print(f"Ganancia total: S/ {df['margen'].sum():,.2f}")
 33:     print(f"Líneas promedio por venta: {len(df) / df['id_venta'].nunique():.2f}")
