  1: from __future__ import annotations
  2: 
  3: from datetime import datetime, timedelta
  4: from pathlib import Path
  5: import random
  6: 
  7: import pandas as pd
  8: 
  9: try:
 10:     from scripts.config import (
 11:         DATA_DIR,
 12:         OUTPUT_DIR,
 13:         RNG,
 14:         SEED,
 15:         TABLAS_MAESTRAS_DIR,
 16:         TOTAL_CLIENTES,
 17:         distribucion_segmento_programa,
 18:         rangos_edades,
 19:     )
 20: except ModuleNotFoundError:
 21:     from config import (
 22:         DATA_DIR,
 23:         OUTPUT_DIR,
 24:         RNG,
 25:         SEED,
 26:         TABLAS_MAESTRAS_DIR,
 27:         TOTAL_CLIENTES,
 28:         distribucion_segmento_programa,
 29:         rangos_edades,
 30:     )
 31: 
 32: 
 33: def _validar_probabilidades(nombre: str, distribucion: dict[str, float], tolerancia: float = 1e-9) -> None:
 34:     total = sum(distribucion.values())
 35:     if abs(total - 1.0) > tolerancia:
 36:         raise ValueError(f"La distribución '{nombre}' debe sumar 1. Actualmente suma {total:.6f}.")
 37: 
 38: 
 39: def _elegir_clave_ponderada(distribucion: dict[str, float], rng: random.Random) -> str:
 40:     claves = list(distribucion.keys())
 41:     pesos = list(distribucion.values())
 42:     return rng.choices(claves, weights=pesos, k=1)[0]
 43: 
 44: 
 45: def _fecha_aleatoria(fecha_inicio: str, fecha_fin: str, rng: random.Random) -> str:
 46:     inicio = datetime.strptime(fecha_inicio, "%Y-%m-%d").date()
 47:     fin = datetime.strptime(fecha_fin, "%Y-%m-%d").date()
 48:     if fin < inicio:
 49:         raise ValueError(f"Rango de fechas inválido: {fecha_inicio} > {fecha_fin}")
 50:     dias = (fin - inicio).days
 51:     return (inicio + timedelta(days=rng.randint(0, dias))).isoformat()
 52: 
 53: 
 54: def _leer_columna_csv(path: Path, columna: str, sep: str = ",") -> list[str]:
 55:     df = pd.read_csv(path, sep=sep)
 56:     if columna not in df.columns:
 57:         raise ValueError(f"No se encontró la columna '{columna}' en {path}. Columnas: {list(df.columns)}")
 58:     valores = df[columna].dropna().astype(str).str.strip()
 59:     valores = valores[valores.ne("")]
 60:     if valores.empty:
 61:         raise ValueError(f"La columna '{columna}' en {path} está vacía.")
 62:     return valores.tolist()
 63: 
 64: 
 65: def _cargar_distribucion_distritos(path: Path) -> pd.DataFrame:
 66:     df = pd.read_csv(path, sep=";")
 67:     columnas_requeridas = {"region", "distrito", "peso_final"}
 68:     faltantes = columnas_requeridas - set(df.columns)
 69:     if faltantes:
 70:         raise ValueError(f"Faltan columnas en {path}: {sorted(faltantes)}")
 71: 
 72:     df = df[["region", "distrito", "peso_final"]].copy()
 73:     df["peso_final"] = pd.to_numeric(df["peso_final"], errors="coerce")
 74:     df = df.dropna(subset=["region", "distrito", "peso_final"])
 75:     df = df[df["peso_final"] > 0]
 76: 
 77:     total = df["peso_final"].sum()
 78:     if total <= 0:
 79:         raise ValueError("La suma de peso_final debe ser mayor que cero.")
 80: 
 81:     # Normaliza por seguridad. Tu CSV ya parece venir normalizado, pero esto evita errores por redondeo.
 82:     df["peso_final"] = df["peso_final"] / total
 83:     return df
 84: 
 85: 
 86: def generar_clientes(total_clientes: int = TOTAL_CLIENTES, seed: int = SEED) -> pd.DataFrame:
 87:     """Genera dim_cliente sin fecha_alta final.
 88: 
 89:     fecha_alta se deja como NaT porque se debe completar desde la primera venta real
 90:     del cliente. Esa actualización está implementada en generar_ventas.py.
 91:     """
 92:     rng = random.Random(seed)
 93: 
 94:     _validar_probabilidades("rangos_edades", {k: v["probabilidad"] for k, v in rangos_edades.items()})
 95:     _validar_probabilidades("distribucion_segmento_programa", distribucion_segmento_programa)
 96: 
 97:     nombres_mujer = _leer_columna_csv(TABLAS_MAESTRAS_DIR / "nombres_mujer.csv", "nombres_mujer")
 98:     nombres_varon = _leer_columna_csv(TABLAS_MAESTRAS_DIR / "nombres_varon.csv", "nombres_varon")
 99:     apellidos = _leer_columna_csv(TABLAS_MAESTRAS_DIR / "apellidos.csv", "apellidos")
100:     distritos = _cargar_distribucion_distritos(TABLAS_MAESTRAS_DIR / "distribucion_clientes_por_distrito.csv")
101: 
102:     rango_probs = {rango: valores["probabilidad"] for rango, valores in rangos_edades.items()}
103:     distrito_opciones = list(distritos.itertuples(index=False, name=None))
104:     distrito_pesos = distritos["peso_final"].tolist()
105: 
106:     registros = []
107:     for id_cliente in range(1, total_clientes + 1):
108:         es_mujer = bool(rng.getrandbits(1))
109:         sexo = "F" if es_mujer else "M"
110:         primer_nombre = rng.choice(nombres_mujer if es_mujer else nombres_varon)
111:         apellido_paterno = rng.choice(apellidos)
112:         apellido_materno = rng.choice(apellidos)
113:         nombre = f"{primer_nombre} {apellido_paterno} {apellido_materno}"
114: 
115:         rango_elegido = _elegir_clave_ponderada(rango_probs, rng)
116:         rango = rangos_edades[rango_elegido]
117:         fecha_nacimiento = _fecha_aleatoria(rango["fecha_inicio"], rango["fecha_fin"], rng)
118: 
119:         region, distrito, _peso = rng.choices(distrito_opciones, weights=distrito_pesos, k=1)[0]
120:         segmento = _elegir_clave_ponderada(distribucion_segmento_programa, rng)
121: 
122:         registros.append(
123:             {
124:                 "id_cliente": id_cliente,
125:                 "nombre": nombre,
126:                 "sexo": sexo,
127:                 "fecha_nacimiento": fecha_nacimiento,
128:                 "distrito": distrito,
129:                 "region": region,
130:                 "fecha_alta": pd.NaT,
131:                 "segmento_programa": segmento,
132:             }
133:         )
134: 
135:     return pd.DataFrame(registros)
136: 
137: 
138: def guardar_clientes(df_clientes: pd.DataFrame, output_path: Path | None = None) -> Path:
139:     output_path = output_path or OUTPUT_DIR / "dim_cliente.csv"
140:     output_path.parent.mkdir(parents=True, exist_ok=True)
141:     df_clientes.to_csv(output_path, sep=";", index=False, encoding="utf-8")
142:     return output_path
143: 
144: 
145: if __name__ == "__main__":
146:     clientes = generar_clientes()
147:     ruta = guardar_clientes(clientes)
148:     print(f"Clientes generados: {len(clientes):,}")
149:     print(f"Archivo creado: {ruta}")
150:     print(clientes.head())
</file>

