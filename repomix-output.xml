 98:     print(f"Fecha mínima: {dim_tiempo['fecha'].min()}")
 99:     print(f"Fecha máxima: {dim_tiempo['fecha'].max()}")
100:     print(f"Feriados: {dim_tiempo['es_feriado'].sum():,}")
