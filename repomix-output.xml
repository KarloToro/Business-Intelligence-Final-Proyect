 34: # -----------------------------------------------------------------------------
 35: # Parámetros del algoritmo de ventas
 36: # -----------------------------------------------------------------------------
 37: FECHA_FIN_EXCLUSIVA_OPERACION = "2026-01-01"
 38: VENTAS_DIARIAS_BASE = 45
 39: VENTAS_DIARIAS_PICO = 60
 40: MESES_PICO = {7, 12}
 41: 
 42: PROB_PRODUCTO_ESTRELLA = 0.80
 43: PROB_ASOCIACION = 0.15
 44: MAX_PROFUNDIDAD_ASOCIACION = 2
 45: MAX_LINEAS_POR_VENTA = 8
 46: COLUMNAS_ASOCIACION = ("asociacion_1", "asociacion_2", "asociacion_3")
 47: 
 48: 
 49: # -----------------------------------------------------------------------------
 50: # Utilidades generales
 51: # -----------------------------------------------------------------------------
 52: def _parse_date(valor: Any) -> datetime.date:
 53:     if hasattr(valor, "date") and not isinstance(valor, str):
 54:         return valor.date()
 55:     return datetime.strptime(str(valor), "%Y-%m-%d").date()
 56: 
 57: 
 58: def _leer_csv_semicolon(path: Path) -> pd.DataFrame:
 59:     if not path.exists():
 60:         raise FileNotFoundError(f"No existe el archivo requerido: {path}")
 61:     return pd.read_csv(path, sep=";")
 62: 
 63: 
 64: def _normalizar_texto(valor: Any) -> str:
 65:     if valor is None or pd.isna(valor):
 66:         return ""
 67:     texto = str(valor).strip()
 68:     texto = unicodedata.normalize("NFKD", texto)
 69:     texto = "".join(ch for ch in texto if not unicodedata.combining(ch))
 70:     return texto.lower().strip()
 71: 
 72: 
 73: def _limpiar_asociacion(valor: Any) -> str | None:
 74:     if valor is None or pd.isna(valor):
 75:         return None
 76:     texto = str(valor).strip()
 77:     if not texto:
 78:         return None
 79:     if texto.lower() in {"nan", "none", "null", "na", "n/a", "sin asociacion", "sin_asociacion"}:
 80:         return None
 81:     return texto
 82: 
 83: 
 84: def _normalizar_pesos(valores: pd.Series | list[float]) -> list[float]:
 85:     pesos = pd.to_numeric(pd.Series(valores), errors="coerce").fillna(0).clip(lower=0)
 86:     total = float(pesos.sum())
 87:     if total <= 0:
 88:         raise ValueError("La suma de pesos debe ser mayor que cero.")
 89:     return (pesos / total).tolist()
 90: 
 91: 
 92: # -----------------------------------------------------------------------------
 93: # Calendario de tickets
 94: # -----------------------------------------------------------------------------
 95: def construir_calendario_tickets(
 96:     fecha_inicio: str = FECHA_INICIO_OPERACION,
 97:     fecha_fin_exclusiva: str = FECHA_FIN_EXCLUSIVA_OPERACION,
 98:     ventas_diarias_base: int = VENTAS_DIARIAS_BASE,
 99:     ventas_diarias_pico: int = VENTAS_DIARIAS_PICO,
100:     meses_pico: set[int] = MESES_PICO,
101: ) -> list[datetime.date]:
102:     """Devuelve una lista de fechas, una por ticket esperado.
103: 
104:     El rango es [fecha_inicio, fecha_fin_exclusiva). Para 2024-01-01 a
105:     2026-01-01 se obtienen 34,755 tickets:
106:     - 45 tickets diarios en meses normales.
107:     - 60 tickets diarios en julio y diciembre.
108:     """
109:     inicio = _parse_date(fecha_inicio)
110:     fin_exclusiva = _parse_date(fecha_fin_exclusiva)
111:     if fin_exclusiva <= inicio:
112:         raise ValueError("fecha_fin_exclusiva debe ser posterior a fecha_inicio.")
113: 
114:     fechas_tickets: list[datetime.date] = []
115:     fecha = inicio
116:     while fecha < fin_exclusiva:
117:         cantidad = ventas_diarias_pico if fecha.month in meses_pico else ventas_diarias_base
118:         fechas_tickets.extend([fecha] * cantidad)
119:         fecha += timedelta(days=1)
120:     return fechas_tickets
121: 
